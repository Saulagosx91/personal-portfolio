---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { site } from '../../data/site';
import { fallbackRepos } from '../../data/githubRepos';

const projects = (await getCollection('projects')).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.year - a.data.year;
});

const allTags = [...new Set(projects.flatMap((p) => p.data.tags))].sort();

// Build-time fetch de repos públicos de GitHub (sin JS en cliente).
let repos = fallbackRepos;
let githubError = false;
try {
  const res = await fetch(
    `https://api.github.com/users/${site.githubUsername}/repos?sort=updated&per_page=6&type=owner`,
    { headers: { Accept: 'application/vnd.github+json' } }
  );
  if (!res.ok) throw new Error(`GitHub ${res.status}`);
  const json = await res.json();
  if (Array.isArray(json) && json.length) {
    repos = json.map((r: any) => ({
      name: r.name,
      description: r.description,
      language: r.language,
      stargazers_count: r.stargazers_count,
      updated_at: r.updated_at,
      html_url: r.html_url,
    }));
  }
} catch {
  githubError = true;
  repos = fallbackRepos;
}
---

<Layout title={`Projects — ${site.name}`} description="Proyectos destacados y repositorios de GitHub.">
  <section class="w-full mx-auto lg:w-[900px] py-16 px-4 flex flex-col gap-10">
    <div data-animate>
      <h1 class="text-3xl font-bold text-white mb-2">Proyectos</h1>
      <p class="text-gray-300">Filtrá por tecnología. Los destacados aparecen primero.</p>
    </div>

    <div data-animate class="flex flex-wrap gap-2 items-center">
      <button data-filter="all" class="filter-btn px-3 py-1.5 rounded-full bg-sky-500 text-white text-sm">Todos</button>
      {allTags.map((tag) => (
        <button data-filter={tag} class="filter-btn px-3 py-1.5 rounded-full bg-gray-800 text-gray-200 text-sm hover:bg-gray-700">{tag}</button>
      ))}
    </div>

    <div id="projects-grid" class="grid gap-6 md:grid-cols-2">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>

    <div data-animate class="mt-8">
      <h2 class="text-2xl font-bold text-white mb-4">Más en GitHub</h2>
      {githubError && (
        <p class="text-sm text-gray-400 mb-3">No se pudo consultar la API de GitHub; mostrando datos de respaldo.</p>
      )}
      <div class="grid gap-4 md:grid-cols-2">
        {repos.map((r) => (
          <a href={r.html_url} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-gray-800 p-4 hover:border-sky-500/50 transition-colors">
            <div class="flex items-center justify-between gap-2">
              <h3 class="font-semibold text-white">{r.name}</h3>
              <span class="text-xs text-gray-400">★ {r.stargazers_count}</span>
            </div>
            <p class="text-sm text-gray-300 mt-1">{r.description ?? 'Sin descripción'}</p>
            <div class="flex items-center justify-between mt-3 text-xs text-gray-400">
              <span>{r.language ?? '—'}</span>
              <span>Actualizado {new Date(r.updated_at).toLocaleDateString('es-ES')}</span>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-4">
        <a href={`https://github.com/${site.githubUsername}`} target="_blank" rel="noopener noreferrer" class="text-sky-400 hover:underline">
          Ver todos mis repositorios →
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  function initProjectsPage() {
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('#projects-grid article');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter') ?? 'all';
        buttons.forEach((b) => {
          b.classList.remove('bg-sky-500', 'text-white');
          b.classList.add('bg-gray-800', 'text-gray-200');
        });
        btn.classList.remove('bg-gray-800', 'text-gray-200');
        btn.classList.add('bg-sky-500', 'text-white');
        cards.forEach((card) => {
          const tags = (card.getAttribute('data-tags') ?? '').split(',');
          const show = filter === 'all' || tags.includes(filter);
          (card as HTMLElement).style.display = show ? '' : 'none';
        });
      });
    });

    const els = document.querySelectorAll('[data-animate]');
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.1 }
      );
      els.forEach((el) => io.observe(el));
    } else {
      els.forEach((el) => el.classList.add('is-visible'));
    }
  }
  document.addEventListener('astro:page-load', initProjectsPage);
</script>
