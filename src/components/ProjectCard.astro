---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
const statusColor =
  data.status === 'completado'
    ? 'bg-emerald-500/15 text-emerald-400 border-emerald-500/30'
    : data.status === 'en desarrollo'
      ? 'bg-amber-500/15 text-amber-400 border-amber-500/30'
      : 'bg-violet-500/15 text-violet-400 border-violet-500/30';
---

<article class="group rounded-xl border border-gray-800 overflow-hidden hover:border-sky-500/50 transition-colors" data-animate data-tags={data.tags.join(',')}>
  <a href={`/projects/${project.id.replace(/\.md$/, '')}`} class="block">
    <!-- <Image src={data.cover} alt={data.title} class="w-full h-48 object-cover" /> -->
  </a>
  <div class="p-4 flex flex-col gap-3">
    <div class="flex items-center justify-between gap-2">
      <h3 class="text-lg font-semibold text-white">
        <a href={`/projects/${project.id.replace(/\.md$/, '')}`} class="hover:text-sky-400">{data.title}</a>
      </h3>
      <span class={`text-xs px-2 py-1 rounded-full border ${statusColor}`}>{data.status}</span>
    </div>
    <p class="text-sm text-gray-300">{data.description}</p>
    <div class="flex flex-wrap gap-2">
      {data.tags.map((tag) => (
        <span class="text-xs px-2 py-1 rounded-full bg-gray-800 text-gray-200">{tag}</span>
      ))}
    </div>
    <div class="flex flex-wrap gap-2 pt-2">
      {data.demoUrl && (
        <a href={data.demoUrl} target="_blank" rel="noopener noreferrer" class="text-sm px-3 py-1.5 rounded-lg bg-sky-500 text-white hover:bg-sky-400">Demo en vivo</a>
      )}
      {data.repoUrl && data.repoVisibility === 'public' && (
        <a href={data.repoUrl} target="_blank" rel="noopener noreferrer" class="text-sm px-3 py-1.5 rounded-lg border border-gray-700 text-gray-200 hover:text-white">Código</a>
      )}
      {data.repoVisibility === 'private' && (
        <span class="text-sm px-3 py-1.5 rounded-lg border border-gray-700 text-gray-400" title="Disponible bajo solicitud">Código privado</span>
      )}
    </div>
  </div>
</article>
