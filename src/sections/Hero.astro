---
import { site } from "../data/site";
---

<section
  id="inicio"
  class="w-full mx-auto lg:w-[740px] py-44 flex flex-col items-center gap-4 text-center"
  data-animate
>
  <span class="text-7xl leading-none" aria-hidden="true">👋</span>
  <div class="flex gap-4 items-center justify-center flex-wrap">
    <h1 class="text-white text-5xl font-bold -mt-2">Hola, Soy Saul Lagos</h1>
    <a
      href="https://www.linkedin.com/in/saul-lagos-9aab41267/"
      target="_blank"
      rel="noopener noreferrer"
    >
    </a>
  </div>
  <h2 class="text-xl">
    Construyo aplicaciones web modernas, rápidas y fáciles de mantener que resuelven problemas reales.
  </h2>
  <div class="flex gap-4 justify-center flex-wrap">
    <a
      href="#proyectos"
      class="px-5 py-2.5 rounded-lg bg-sky-500 text-white font-medium hover:bg-sky-400 transition-colors"
    >
      Ver proyectos
    </a>
    <a
      href={site.cvPath}
      download
      class="px-5 py-2.5 rounded-lg border border-sky-500 text-sky-400 font-medium hover:bg-sky-500/10 transition-colors"
    >
      Descargar CV
    </a>
  </div>
</section>
