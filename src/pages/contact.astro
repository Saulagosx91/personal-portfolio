---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import Icon from '../components/Icon.astro';
---

<Layout title={`Contacto — ${site.name}`} description="Cómo contactarme.">
  <section class="w-full mx-auto lg:w-[740px] py-16 px-4 flex flex-col gap-6" data-animate>
    <h1 class="text-3xl font-bold text-white">Contacto</h1>
    <p class="text-gray-300">Puedes escribirme por cualquiera de estos canales.</p>
    <div class="flex flex-col gap-4">
      <a href={`mailto:${site.email}`} class="flex items-center gap-3 px-5 py-3 rounded-lg border border-gray-700 text-gray-200 hover:border-sky-500 hover:text-white transition-colors">
        Correo: {site.email}
      </a>
      <a href={`https://github.com/${site.githubUsername}`} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 px-5 py-3 rounded-lg border border-gray-700 text-gray-200 hover:border-sky-500 hover:text-white transition-colors">
        <Icon name="github" class="h-5 w-5" /> GitHub
      </a>
      <a href={site.whatsapp} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 px-5 py-3 rounded-lg border border-gray-700 text-gray-200 hover:border-sky-500 hover:text-white transition-colors">
        WhatsApp
      </a>
    </div>
  </section>
</Layout>

<script>
  function initAnimate() {
    const els = document.querySelectorAll('[data-animate]');
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.1 }
      );
      els.forEach((el) => io.observe(el));
    } else {
      els.forEach((el) => el.classList.add('is-visible'));
    }
  }
  document.addEventListener('astro:page-load', initAnimate);
</script>
