---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { skillGroups } from "../data/skills";
import { experience, education } from "../data/experience";
import { certifications } from "../data/certifications";
import { site } from "../data/site";
---

<Layout
  title={`About — ${site.name}`}
  description="Sobre mí, habilidades, experiencia y educación."
>
  <section class="w-full mx-auto lg:w-[740px] py-16 px-4 flex flex-col gap-12">
    <div data-animate>
      <h1 class="text-3xl font-bold text-white mb-4">Sobre mí</h1>
      <p class="text-gray-300 leading-relaxed">
        Soy egresado de <strong class="text-sky-400"
          >Ingeniería de Sistemas</strong
        > y desarrollador frontend. Me enfoco en la construcción de interfaces interactivas
        que resuelvan problemas de forma funcional. Me apasiona aprender nuevas tecnologías
        y mejorar mis habilidades de desarrollo web. Actualmente busco oportunidades
        para crecer profesionalmente y contribuir a proyectos importantes.
      </p>
      <br />
      <p class="text-gray-300 leading-relaxed">
        Disfruto trabajar en equipo y compartir con otros desarrolladores, ya que considero que es la
        mejor forma de aprender y crecer. También me gusta resolver problemas
        con soluciones tecnológicas creativas .
      </p>
    </div>

    <div data-animate>
      <h2 class="text-2xl font-bold text-white mb-6">Skills</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {
          skillGroups.map((group) => (
            <div class="rounded-xl border border-gray-800 p-4">
              <h3 class="text-sky-400 font-semibold mb-3">{group.category}</h3>
              <ul class="flex flex-wrap gap-3">
                {group.items.map((skill) => (
                  <li class="flex items-center gap-2 text-sm text-gray-200">
                    <Icon name={skill.icon} class="h-5 w-5 text-sky-400" />
                    {skill.name}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    {
      experience.length > 0 && (
        <>
          <div data-animate>
            <h2 class="text-2xl font-bold text-white mb-6">Experiencia</h2>
            <ol class="relative border-l border-gray-700 ml-3">
              {experience.map((item) => (
                <li class="mb-8 ml-6">
                  <span class="absolute -left-1.5 mt-1.5 h-3 w-3 rounded-full bg-sky-500" />
                  <h3 class="font-semibold text-white">{item.title}</h3>
                  <p class="text-sm text-sky-400">
                    {item.place} · {item.period}
                  </p>
                  <p class="text-gray-300 mt-1">{item.description}</p>
                </li>
              ))}
            </ol>
          </div>
        </>
      )
    }

    <div data-animate>
      <h2 class="text-2xl font-bold text-white mb-6">Educación</h2>
      <ol class="relative border-l border-gray-700 ml-3">
        {
          education.map((item) => (
            <li class="mb-8 ml-6">
              <span class="absolute -left-1.5 mt-1.5 h-3 w-3 rounded-full bg-sky-500" />
              <h3 class="font-semibold text-white">{item.title}</h3>
              <p class="text-sm text-sky-400">
                {item.place} · {item.period}
              </p>
              <p class="text-gray-300 mt-1">{item.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
    <div data-animate>
      <h2 class="text-2xl font-bold text-white mb-6">
        Certificaciones y logros
      </h2>
      <div class="grid gap-4 md:grid-cols-2">
        {
          certifications.map((c) => (
            <div class="rounded-xl border border-gray-800 p-4">
              <h3 class="font-semibold text-white">{c.title}</h3>
              <p class="text-sm text-sky-400">
                {c.issuer} · {c.date}
              </p>
              {c.url && (
                <a
                  href={c.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-gray-300 hover:text-white mt-2 inline-block"
                >
                  Ver diploma
                </a>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<script>
  const els = document.querySelectorAll("[data-animate]");
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("is-visible");
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.1 },
    );
    els.forEach((el) => io.observe(el));
  } else {
    els.forEach((el) => el.classList.add("is-visible"));
  }
</script>
