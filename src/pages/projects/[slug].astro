---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.md$/, '') },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const statusColor =
  data.status === 'completado'
    ? 'text-emerald-400'
    : data.status === 'en desarrollo'
      ? 'text-amber-400'
      : 'text-violet-400';
---

<Layout title={`${data.title} — ${site.name}`} description={data.description}>
  <article class="w-full mx-auto lg:w-[800px] py-16 px-4 flex flex-col gap-8">
    <div data-animate>
      <a href="/projects" class="text-sky-400 hover:underline text-sm">← Volver a proyectos</a>
      <h1 class="text-3xl font-bold text-white mt-3">{data.title}</h1>
      <p class="text-gray-300 mt-2">{data.description}</p>
      <div class="flex flex-wrap gap-3 mt-4 text-sm">
        <span class={statusColor}>{data.status}</span>
        <span class="text-gray-400">{data.year}</span>
        <span class="text-gray-400">{data.role}</span>
      </div>
      <div class="flex flex-wrap gap-2 mt-3">
        {data.tags.map((tag) => (
          <span class="text-xs px-2 py-1 rounded-full bg-gray-800 text-gray-200">{tag}</span>
        ))}
      </div>
    </div>

    <Image src={data.cover} alt={data.title} class="w-full rounded-xl object-cover" data-animate />

    <div class="prose prose-invert max-w-none" data-animate>
      <Content />
    </div>

    {data.images.length > 0 && (
      <div data-animate class="grid gap-4 md:grid-cols-2">
        {data.images.map((img, i) => (
          <Image src={img} alt={`${data.title} captura ${i + 1}`} class="rounded-xl" />
        ))}
      </div>
    )}

    {data.videoUrl && (
      <div data-animate>
        <video controls class="w-full rounded-xl" src={data.videoUrl}></video>
      </div>
    )}

    <div data-animate class="flex flex-wrap gap-3 pt-4">
      {data.demoUrl && (
        <a href={data.demoUrl} target="_blank" rel="noopener noreferrer" class="px-4 py-2 rounded-lg bg-sky-500 text-white hover:bg-sky-400">Demo en vivo</a>
      )}
      {data.repoUrl && data.repoVisibility === 'public' && (
        <a href={data.repoUrl} target="_blank" rel="noopener noreferrer" class="px-4 py-2 rounded-lg border border-gray-700 text-gray-200 hover:text-white">Código</a>
      )}
      {data.repoVisibility === 'private' && (
        <span class="px-4 py-2 rounded-lg border border-gray-700 text-gray-400">Código privado</span>
      )}
    </div>
  </article>
</Layout>

<script>
  function initAnimate() {
    const els = document.querySelectorAll('[data-animate]');
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.1 }
      );
      els.forEach((el) => io.observe(el));
    } else {
      els.forEach((el) => el.classList.add('is-visible'));
    }
  }
  document.addEventListener('astro:page-load', initAnimate);
</script>
